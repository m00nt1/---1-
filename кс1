def sum_negative_between_min_max(arr):
    if len(arr) < 3:
        return 0
    
    min_idx = max_idx = 0
    for i in range(1, len(arr)):
        if arr[i] < arr[min_idx]:
            min_idx = i
        if arr[i] > arr[max_idx]:
            max_idx = i
    
    left = min(min_idx, max_idx) + 1
    right = max(min_idx, max_idx)
    
    return sum(x for x in arr[left:right] if x < 0)
